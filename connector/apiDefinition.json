{
  "swagger": "2.0",
  "info": {
    "title": "CZ Connector Proof",
    "description": "Delegated OAuth to APIM; APIM application identity to the backend.",
    "version": "1.0.0"
  },
  "host": "configured-by-export.invalid",
  "basePath": "/cz",
  "schemes": ["https"],
  "produces": ["application/json"],
  "paths": {
    "/proof": {
      "get": {
        "operationId": "GetProof",
        "summary": "Get identity-boundary proof",
        "x-ms-summary": "Get identity-boundary proof",
        "responses": {
          "200": {
            "description": "Authorized backend response",
            "schema": {
              "type": "object",
              "properties": {
                "message": { "type": "string" },
                "version": { "type": "string" },
                "authentication": {
                  "type": "object",
                  "properties": {
                    "tokenType": { "type": "string" },
                    "role": { "type": "string" },
                    "callerIsApim": { "type": "boolean" },
                    "callerClientIsApim": { "type": "boolean" },
                    "delegatedScopePresent": { "type": "boolean" },
                    "userContextPresent": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "401": { "description": "Invalid subscription or delegated token" },
          "403": { "description": "Backend application authorization failed" }
        }
      }
    }
  }
}
